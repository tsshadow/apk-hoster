# APK Hoster Configuration
APP_NAME=APK Hoster
PORT=8275

# Local path where APKs are stored
DIST_DIR=dist

# Upload Security
ADMIN_PASS=
# Non-admin account seeded on startup (upload + download + view).
DEFAULT_USER=user
DEFAULT_USER_PASSWORD=
ALLOWED_IPS=

# Series renames: keep answering an old APK name with a new series, so
# already-installed copies still find updates. Format: old=new,old2=new2
APK_ALIASES=

# Database Configuration
# DB_TYPE: 'sqlite' or 'mysql'
DB_TYPE=sqlite
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=apk-hoster
MYSQL_PASSWORD=
MYSQL_DATABASE=apk-hoster
MYSQL_ROOT_PASSWORD=
